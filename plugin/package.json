{
  "name": "lc-station",
  "version": "0.2.0",
  "description": "LC Workstation for DSH: card-chain canvas folded from the session event stream, plus memory / calls / outputs views, bilingual UI (zh / en). No model calls on the chat path.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "plugin",
    "workstation",
    "canvas",
    "card-chain",
    "session-events",
    "i18n",
    "marketplace",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liangchen-h/lc-station.git"
  },
  "homepage": "https://github.com/liangchen-h/lc-station#readme",
  "license": "MIT"
}
